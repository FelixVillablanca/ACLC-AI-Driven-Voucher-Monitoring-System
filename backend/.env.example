APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# System health checks the web app & API here every minute (php artisan serve). XAMPP Apache on :80 is NOT the API.
HEALTH_WEB_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE=+08:00

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Production: SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true (HTTPS-only cookie; the default when APP_ENV=production),
# SESSION_SAME_SITE=lax, APP_DEBUG=false
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local default: emails are written to storage/logs/laravel.log, not sent.
# To send real email through Gmail, use these instead (needs a Google App Password):
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#   MAIL_USERNAME=you@gmail.com  MAIL_PASSWORD=<16-char app password, no spaces>
#   MAIL_FROM_ADDRESS="you@gmail.com"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# React app address (CORS + Sanctum cookie login)
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Python ML microservice (Phase 5). Leave empty until it exists.
ML_SERVICE_URL=

# OpenAI: report summaries (empty = not set up; reports still build without the AI text)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database backups (config/backup.php). Only needed if mysqldump isn't on PATH:
# BACKUP_MYSQLDUMP_BINARY="C:\xampp\mysql\bin\mysqldump.exe"
# BACKUP_NIGHTLY_AT=02:00
# BACKUP_KEEP=7
